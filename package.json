{
  "version": "5.0.0",
  "name": "cordova-custom-config-example",
  "cordova_name": "cordova-custom-config-example",
  "description": "Example project to illustrate/validate usage of cordova-custom-config Cordova/Phonegap plugin",
  "author": "Dave Alden",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dpa99c/cordova-custom-config-example.git"
  },
  "cordova": {
    "id": "cordova-custom-config-example",
    "platforms": [
      "ios",
      "android"
    ],
    "plugins": {
      "cordova-custom-config": {}
    }
  },
  "issue": "https://github.com/dpa99c/cordova-custom-config-example/issues",
  "scripts": {
    "test": "npm run-script lint && cordova prepare && jasmine",
    "lint": "jshint plugins/cordova-custom-config/hooks"
  },
  "dependencies": {
    "cordova-custom-config": "*"
  },
  "devDependencies": {
    "cordova-android": "^15.1.0",
    "cordova-ios": "^8.1.1",
    "jasmine": "^2.5.2",
    "jshint": "^2.6.0"
  }
}
